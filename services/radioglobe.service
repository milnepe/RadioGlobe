[Unit]
Description=RadioGlobe Service
After=pulseaudio.service

[Service]
Type=simple
WorkingDirectory=__RADIOGLOBE_DIR__
EnvironmentFile=-__RADIOGLOBE_DIR__/version.env
Environment=PULSE_LATENCY_MSEC=300
ExecStart=/bin/bash -c 'echo "RadioGlobe $RADIOGLOBE_VERSION"; exec __RADIOGLOBE_DIR__/venv/bin/radioglobe'
Restart=always

[Install]
WantedBy=default.target
